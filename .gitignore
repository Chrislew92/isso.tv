# Dependencies and generated output
node_modules/
dist/
artifacts/

# Local environment and secrets
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temporary Vite files
*.log
npm-debug.log*
vite.config.*.timestamp-*

# Blender automatic backups
*.blend1

# User-provided binary masters stay local; reproducible build reports record hashes.
assets/source/*-original.glb

# Superseded local character builds are recoverable but never part of the active game.
assets/archive/
.cache/
